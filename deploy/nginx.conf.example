# Example only. Replace name/certificates and align PublicOrigin/AllowedHosts.
# Kestrel must be private; never trust forwarded headers from arbitrary clients.
server {
    listen 443 ssl;
    server_name observatory.example.test;
    ssl_certificate /etc/ssl/observatory/fullchain.pem;
    ssl_certificate_key /etc/ssl/observatory/privkey.pem;
    client_max_body_size 8k;
    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
