[Unit]
Description=SQL Server Performance Observatory
After=network-online.target
[Service]
Type=simple
User=observatory
Group=observatory
WorkingDirectory=/opt/observatory
EnvironmentFile=/etc/observatory/environment
ExecStart=/usr/bin/dotnet /opt/observatory/Observatory.Web.dll
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/observatory
UMask=0077
[Install]
WantedBy=multi-user.target
