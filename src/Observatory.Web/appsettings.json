{
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "Observatory": {
    "Mode": "Replay",
    "PublicOrigin": "http://localhost:5080",
    "StateDirectory": "state",
    "HistoryLimit": 48,
    "TrustedProxies": [],
    "Collection": {
      "QueryPeriodSeconds": 120,
      "BlockingPeriodSeconds": 10,
      "DeadlockPeriodSeconds": 120,
      "LookbackHours": 24,
      "CommandTimeoutSeconds": 5,
      "QueryRowLimit": 5000,
      "BlockingRowLimit": 200,
      "DeadlockLimit": 200,
      "AllowUntrustedCertificateForLocalLab": false
    },
    "Targets": [
      {
        "Id": "primary",
        "DisplayName": "Primary database",
        "ConnectionEnvironment": "SPO_SQL_PRIMARY",
        "CaptureBlocking": false,
        "CaptureDeadlocks": false,
        "XeFilePattern": "system_health*.xel"
      }
    ]
  }
}
